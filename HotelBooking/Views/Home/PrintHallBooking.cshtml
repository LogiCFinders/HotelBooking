@model HotelBooking.Model.Hall.HallBooking
@{
    ViewBag.Title = "Print Hall Booking";
}
<link href="~/css/HallBooking.css" rel="stylesheet" />
<div class="row" id="PrintHallBooking">
    <div class="col-sm-12">
        <div class="card widget-container" id="BookingFirstPage">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">


                <h3 style=" font-size: 18px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>


                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Customer Name</label>
                    <input type="text" id="txtCustomerName" class="full-width" value="@Model.CustomerName" placeholder="Customer Name " readonly="readonly" maxlength="100" runat="server">
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Customer Email</label>
                    <input type="text" id="txtCustomerEmail" class="full-width" value="@Model.CustomerEmail" placeholder="Customer Email" readonly="readonly" maxlength="150" runat="server">
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Customer Phone</label>
                    <input type="text" id="txtCustomerPhone" class="full-width" value="@Model.CustomerPhone" placeholder="Customer Phone Number" readonly="readonly" maxlength="15" runat="server">
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Number of Person</label>
                    <input type="text" id="txtNPax" class="full-width" value="@Model.Number_Of_Person" placeholder="Number of Person" readonly="readonly" maxlength="15" runat="server">
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Select a Hall</label>
                    <select name="SelHall" id="SelHall" disabled="disabled" class="full-width freetrial">
                        @if (ViewBag.PartyHall != null)
                        {
                            foreach (var item in ViewBag.PartyHall)
                            {
                                if (item.Text != null)
                                {
                                    <option value="@item.Value" selected="@item.Selected">
                                        @item.Text.Trim()
                                    </option>

                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Select a Slot</label>
                    <select name="SelSlot" id="SelSlot" disabled="disabled" class="full-width freetrial">
                        @if (ViewBag.Slots != null)
                        {
                            foreach (var item in ViewBag.Slots)
                            {
                                if (item.Text != null)
                                {
                                    <option value="@item.Value" selected="@item.Selected">
                                        @item.Text.Trim()
                                    </option>

                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 pull-left">
                    <label for="edit-mail" class="form-required">Select a Menu</label>
                    <select name="SelBM" id="SelBM" disabled="disabled" class="full-width freetrial">
                        @if (ViewBag.BuffetMenus != null)
                        {
                            foreach (var item in ViewBag.BuffetMenus)
                            {
                                if (item.Text != null)
                                {
                                    <option value="@item.Value" selected="@item.Selected">
                                        @item.Text.Trim()
                                    </option>

                                }
                            }
                        }
                    </select>
                </div>





                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 p-0 pull-left">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Hall/Party on</label>
                        <input type="text" id="HallBookingDate" readonly="readonly" value="@Model.BookingDate" class="full-width allinputgo  ValidateInput" placeholder="Hall Booking Date" autocomplete="off">
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblBFM">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" class="clrwhit">Category</th>
                                    <th bgcolor="#003556" class="clrwhit">Items</th>

                                </tr>

                            </thead>
                            <tbody>
                                
                            </tbody>
                        </table>
                    </div>
                </div>
               



                    <div class="card widget-container" id="step3" style="display:block">


                        <h3 style=" font-size: 12px; font-weight: 600; color: #003556; text-align: center; padding: 15px 0px 0px 15px;"> Theme & Decoration</h3>

                        <div class="row">

                            <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                                <table class="table table-bordered" id="tblTheme">
                                    <thead>
                                        <tr>
                                            <th bgcolor="#003556" colspan="2" style="align-items: center" class="clrwhit">Selected Theme</th>

                                        </tr>

                                    </thead>
                                    <tbody>
                                        @if (ViewBag.Decoration != null)
                                        {
                                            foreach (var dcr in ViewBag.Decoration)
                                            {
                                                var txAmt = dcr.COST * dcr.Tax / 100;
                                                var totalCost = dcr.COST + dcr.TaxAmount;
                                                var trselectedVal = dcr.isSelected ? "YES" : "";

                                                <tr id="@dcr.ServiceId" Name="@dcr.Title" Cost="@dcr.COST" Tax="@dcr.Tax"  ThemeSelected="@trselectedVal" TaxAmount="@txAmt">

                                                    <td>@dcr.Title</td>
                                                    <td>@totalCost</td>
                                                    

                                                </tr>
                                            }
                                        }
                                    </tbody>

                                </table>

                            </div>

                        </div>






                    </div>


                
               

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblStalls">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" style="align-items: center" class="clrwhit">Selected Stalls</th>

                                </tr>

                            </thead>
                            <tbody>
                                @if (ViewBag.Stall != null)
                                {
                                    <tr>
                                        <td>
                                            <div class="cont-main">
                                                @foreach (var dcr in ViewBag.Stall)
                                                {
                                                    var chkId = "myCheckbox-" + dcr.ServiceId;
                                                    String img6412 = Convert.ToBase64String(dcr.StreamData);
                                                    String img64Url12 = string.Format("data:image/jpeg;base64,{0}", img6412); //imagetype can be e.g. gif, jpeg, png etc.
                                                    var txAmt = dcr.COST * dcr.Tax / 100;
                                                    var totalCost = dcr.COST + dcr.TaxAmount;


                                                    <div class="cont-checkbox">
                                                        <input title="test" style="visibility:hidden" type="checkbox" id="@chkId" svcId="@dcr.ServiceId" Name="@dcr.Title" Cost="@dcr.COST" Tax="@dcr.Tax" TaxAmount="@txAmt" checked="@dcr.isSelected" />
                                                        <label for="@chkId">

                                                            <img src="@img64Url12" style="width:15%;height:15%" alt="" />

                                                            <div class="info">@dcr.Title</div>
                                                        </label>
                                                    </div>



                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>

                            </tfoot>
                        </table>

                    </div>

              

               

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblVehicle">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" style="align-items: center" class="clrwhit">Selected Vehicle</th>

                                </tr>

                            </thead>
                            <tbody>
                                @if (ViewBag.Trans != null)
                                {
                                    <tr>
                                        <td>
                                            <div class="cont-main">
                                                @foreach (var dcr in ViewBag.Trans)
                                                {
                                                    var chkId = "myCheckbox-" + dcr.ServiceId;
                                                    String img6412 = Convert.ToBase64String(dcr.StreamData);
                                                    String img64Url12 = string.Format("data:image/jpeg;base64,{0}", img6412); //imagetype can be e.g. gif, jpeg, png etc.
                                                    var txAmt = dcr.COST * dcr.Tax / 100;
                                                    var totalCost = dcr.COST + dcr.TaxAmount;


                                                    <div class="cont-checkbox">
                                                        <input title="test" type="checkbox" style="visibility:hidden" id="@chkId" svcId="@dcr.ServiceId" Name="@dcr.Title" Cost="@dcr.COST" Tax="@dcr.Tax" TaxAmount="@txAmt" checked="@dcr.isSelected" />
                                                        <label for="@chkId">

                                                            <img src="@img64Url12" style="width:15%;height:15%" alt="" />

                                                            <div class="info">@dcr.Title</div>
                                                        </label>
                                                    </div>


                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>

                            </tfoot>
                        </table>

                    </div>

                
                

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblCosting">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" class="full-width" style="color:#FFFFFF" align="center" colspan="3">Costing</th>
                                   

                                </tr>
                                <tr>

                                    <th bgcolor="#003556" class="clrwhit">#</th>
                                    <th bgcolor="#003556" class="clrwhit">Description</th>
                                    <th bgcolor="#003556" align="right" class="clrwhit">Amount </th>

                                </tr>
                            </thead>
                            <tbody>


                                <tr>
                                    <td>#</td>
                                    <td align="left">Hall Rent</td>
                                    <td align="right"><span id="hRentCostId"></span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Food Costing</td>
                                    <td align="right"><span id="fdCostingId">0.00</span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Theme & Decoration</td>
                                    <td align="right"><span id="themeCostingId">0.00</span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Additional Stalls</td>
                                    <td align="right"><span id="stallCostingId">0.00</span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Transport &; Vehicle</td>
                                    <td align="right"><span id="vehicleCostingId">0.00</span></td>
                                </tr>
                                <tr>

                                    <td align="right" colspan="2">Total Cost</td>
                                    <td align="right"><span id="totalCostId"></span></td>
                                </tr>
                                <tr>
                                    <td bgcolor="#003556" align="center" style="color:#FFFFFF" colspan="3">Payment</td>
                                </tr>
                                <tr>

                                    <td bgcolor="#003556" class="clrwhit">Payment Date</td>
                                    <td bgcolor="#003556" class="clrwhit">Description</td>
                                    <td bgcolor="#003556" align="right" class="clrwhit">Amount </td>

                                </tr>
                                @foreach (var pmt in Model.HallBookingPayment)
                                {
                                    <tr id="@pmt.HallBookingPaymentId">

                                        <td align="left">@pmt.paymentDate</td>
                                        <td align="left"><input type="text" id="txtPmtDesc" class="full-width" placeholder="Description" maxlength="15" readonly="readonly" value="@pmt.Description" runat="server"></td>
                                        <td align="right"><input type="text" id="txtPmtAmt" class="full-width" style="text-align:right !important" readonly="readonly" placeholder="Amount" maxlength="15" value="@pmt.Amount" runat="server"></td>


                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

               

                

                <div class="col-lg-2 col-md-2 col-sm-6 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>
                    <input type="button" name="SUBMIT" class="prev action-button full-width mg-0 " onclick="PrintHallBooking(this);" value="Print" runat="server">
                </div>

            </form>
        </div>
    </div>
</div>
<script>
    let HallBookingDetails= '' || [];
    $(document).ready(function () {
        $("#hRentCostId").change(function () {
            CalCulateTotal();
        });
        $("#fsvsostingId").change(function () {
            CalCulateTotal();
        });
        $("#fdCostingId").change(function () {
            //console.log("Change Event fired");
            CalCulateTotal();
        });
        var ArrMId = $("#SelBM option:selected").val().split("-");
        //$("#SelBM").val(Number(ArrMId[0]));

        var nPax = @Model.Number_Of_Person;
        mCost = Number(ArrMId[1]);
        var totalFoodCost = Number(mCost) * Number(nPax);
        $("#fdCostingId").text(Number(totalFoodCost).toFixed(2));
        $("#fdCostingId").trigger("change");
        AddPStoCosting();



        $("#SelSlot").val('@Model.SlotId');

        var ArrhId = $("#SelHall option:selected").val().split("-");


        $("#hRentCostId").text(Number(ArrhId[1]).toFixed(2));
        $("#hRentCostId").trigger("change");



        getBuffetMenuDetails(ArrMId[0]);



        $("#HallBookingDate").datepicker({
            dateFormat: "mm-dd-yy",
            duration: "fast",
            minDate: 0,
            disabledDates: [new Date()],

        });
        AddStalltoCosting();
        AddVehicletoCosting();

    });
    function getBuffetMenuDetails(menuId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("getBuffetMenu", "Home")',

            data: { buffetMenuId: menuId },

            success: function (GLBuffetMenuDetails) {
                var trItems = "";
                //console.log("test"+GLBuffetMenuDetails);
                GLBuffetMenuDetails.forEach((itm, itmIndex) => {

                    trItems += ' <tr>    ';
                    trItems += '<td style="padding:10px 15px !important"><ul class="menulist"> <h3>' + itm.BuffetMenuCategory + ' </h3>';
                    var itemIds = "'";
                    var headingIds;
                    itm.ItemDetails.forEach((itm1, itmIndex) => {
                        itemIds = itemIds + itm1.ItemId + "-";
                        headingIds = itm1.HeadingId;
                        var chkid = 'CHK_' + itm1.ItemId;
                        var isSelected = '';
                        var isfound = isAlreadySelected(itm1.ItemId);
                        if (isfound) {
                            isSelected = "checked=checked";
                        }
                        trItems += '<li align="left"  valign="middle">';
                        trItems += '<input type="checkbox" ' + isSelected + ' class="styled-checkbox"  bfmItemid="' + itm1.BuffetMenuItemId + '" bfmid="' + itm1.BuffetMenuId + '" id="' + chkid + '" hId="' + itm1.HeadingId + '" value="' + itm1.ItemName + '" name="' + itm.BuffetMenuId + '" onclick="checkSelection(this,' + itm.MenuOption + ');" /><label for="' + chkid + '">' + itm1.ItemName + '</label></li>';

                    });
                    itemIds = itemIds + "'"
                    trItems += '</ul></td>';
                    //trItems += '<td align="left" id="XXX" valign="middle" class="text-right"><a href="#" onclick="EditCategory(' + itm.MenuOption + ',' + itm.CategoryId + ',' + headingIds + ',' + itemIds + ');" class="editbtn"><i class="fa fa-edit"></i> Edit</a></td>';
                    trItems += '</tr>';
                });
                $("#tblBFM tbody").empty();
                $("#tblBFM tbody").append(trItems);


                },
                error: function () {

                 console.log('A error');
                }
        });

    }
    function checkSelection(n, opt) {
        var selectedItems = [];
        $.each($("input[name='"+n.name+"']:checked"), function () {
            selectedItems.push($(this).val());
        });
        //console.log("My favourite sports are: " + favorite.join(", "));
        console.log("item selected: " + selectedItems.length +"   "+opt);
        if (selectedItems.length > opt) {

            $(n).prop('checked', false);
            return false;
        }

    }
    function isAlreadySelected(itemId) {
        var itemsId = [];
var rtnVal = false;
//console.log(itemId);

var ArrItems1='@Model.HallBookingDetails';
var ArrItems = ArrItems1.split(',');
//console.log(ArrItems);
ArrItems.forEach((itm, itmIndex) => {

    itemsId.push(Number(itm.substring(4)));


});
//console.log(itemsId);
var index = $.inArray(itemId, itemsId);

if (index !== -1) {
    //console.log("Value found at index: " + index);
    rtnVal = true;
} else {
    //console.log("Value not found in the array.");
    rtnVal = false;
}
return rtnVal;

    }
    function SaveHallBooking() {
        const BranchId = '@ViewBag.BranchId';
        const bDate = $("#HallBookingDate").val();
        const cName = $("#txtCustomerName").val();
        const cEmail = $("#txtCustomerEmail").val();
        const cPhone = $("#txtCustomerPhone").val();
        const nPax = $("#txtNPax").val();
        const ArrmId = $("#SelBM option:selected").val().split("-");
        var mId = ArrmId[0];
        var mCost = ArrmId[1];
        const mName = $("#SelBM option:selected").text().replace(/[\n\r]+/g, ' ').trim();;
        const sId = $("#SelSlot option:selected").val();
        const sName = $("#SelSlot option:selected").text().replace(/[\n\r]+/g, ' ').trim();;
        const ArrhId = $("#SelHall option:selected").val().split("-");
        var hId = ArrhId[0];
        var HallRentCost = ArrhId[1];
        const hName = $("#SelHall option:selected").text().replace(/[\n\r]+/g, ' ').trim();;
        var totAmt = 0;
        var totTax = 0;

