            }

            $(this).find('td').each(function (index) {

                if (index == 1) {
                    $(this).find("input").each(function () {
                        var txtDesc = $(this).val();
                        console.log("Testing..." + txtDesc);
                        svsCosting.Description = txtDesc;
                    });

                }
                if (index == 2) {
                    $(this).find("input").each(function () {
