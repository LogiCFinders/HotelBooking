@model HotelBooking.Model.Hall.VM_HallServices
@{
    ViewBag.Title = "Add Hall Services";
}


    <div class="row" id="AddHallservices" style="display: block;">
        <div class="col-sm-12">
            <div class="card widget-container">
                <div class="heading"> <i class="fa fa-bar-chart-o"></i>Add Hall Services</div>
                <div class="widget-content padded text-center">
                    <div class="row">
                        <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive pull-left">
                            @using (Html.BeginForm("SaveHallServices", "Home", FormMethod.Post, new { id = "msform", enctype = "multipart/form-data" }))
                            {
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pull-left">
                                    <label for="edit-mail" class="form-required">Title</label>

                                    @Html.TextBoxFor(m => m.Title, new { @class = "full-width ValidateInput", placeholder = "Title", maxlength = "100" })
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pull-left">
                                    <label for="edit-mail" class="form-required">Short Discription</label>
                                    @Html.TextAreaFor(m => m.ShortDescription, new { @class = "full-width", maxlength = "500" })

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pull-left">
                                    <label for="edit-mail" class="form-required">Discription</label>
                                    @Html.TextAreaFor(m => m.Description, new { @class = "full-width ValidateInput", maxlength = "500" })
                                </div>


                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 pull-left">
                                    <label for="edit-mail" class="form-required">Price</label>

                                    @Html.TextBoxFor(m => m.COST, new { @class = "full-width ValidateInput", placeholder = "Price", maxlength = "7", valType = "NumbersOnly" })
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-6 pull-left">
                                    <label for="edit-mail" class="form-required">Tax Percentage</label>

                                    @Html.TextBoxFor(m => m.Tax, new { @class = "full-width ValidateInput", placeholder = "Tax Percentage", maxlength = "5", valType = "NumbersOnly" })
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 pull-left">
                                    <label for="edit-mail" class="form-required">Select a Menu</label>
                                    <select name="SelCat" id="SelCat" class="full-width freetrial">
                                        @if (ViewBag.SvcCat != null)
                                        {
                                            foreach (var item in ViewBag.SvcCat)
                                            {
                                                if (item.Text != null)
                                                {
                                                    <option value="@item.Value" selected="@item.Selected">
                                                        @item.Text.Trim()
                                                    </option>

                                                }
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pull-left">
                                    <table class="table table-bordered" style="width:100%">
                                        <tbody>
                                            <tr>
                                                <td>Select Image/Video</td>
                                                <td>
                                                    <input type="file" id="RTImageData" name="RTImageData" accept="image/jpg,image/png,image/jpeg,image/gif,video/mp4" class=" full-width">

                                                    <p id="error1" style="display:none; color:#FF0000;">
                                                        Invalid Image Format! Image Format Must Be JPG, JPEG, PNG ,GIF or Video(mp3/mp4).
                                                    </p>
                                                    <p id="error2" style="display:none; color:#FF0000;">
                                                        Maximum File Size Limit is 1MB.
                                                    </p>

                                                </td>

                                            </tr>
                                        </tbody>
                                    </table>

                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pull-left">

                                    <ul class="unstyled">
                                        <li>
                                            <input class="styled-checkbox" id="styled-checkbox-2" name="CHK_ACTIVE" type="checkbox" checked="@Model.isActive">

                                            <label for="styled-checkbox-2">Active</label>
                                        </li>

                                    </ul>
                                    @Html.HiddenFor(m => m.isActive);
                                    @Html.HiddenFor(m => m.Category);
                                </div>
                                   
                                    <input type="submit" name="SUBMIT" class="prev action-button" onclick="return addDatatoModel();" value="Save" runat="server">
                                    @*<input type="button" id="ajaxUpload" class="prev action-button" value="Ajax Upload" />*@
                                   
                               }

                             </div>
                        </div>
                </div>
            </div>
        </div>
    </div>




    <script>

        $(document).ready(function () {
            $("input").attr("autocomplete", "none");
            $(".ValidateInput").on("blur", function () {
                validateField(this);
            });
            var a = 0;
            $('#btnSubmit').prop("disabled", true);
            $('#RTImageData').bind('change', function () {
                if ($('#btnSubmit').attr('disabled', false)) {
                    $('#btnSubmit').attr('disabled', true);
                }
                var ext = $('#RTImageData').val().split('.').pop().toLowerCase();
                if ($.inArray(ext, ['gif', 'png', 'jpg', 'jpeg','mp3','mp4']) == -1) {
                    $('#error1').slideDown("slow");
                    $('#error2').slideUp("slow");
                    a = 0;
                } else {
                    var picsize = (this.files[0].size);
                    if (picsize > 15000000) {
                        $('#error2').slideDown("slow");
                        a = 0;
                    } else {
                        a = 1;
                        $('#error2').slideUp("slow");
                    }
                    $('#error1').slideUp("slow");
                    if (a == 1) {
                        $('#btnSubmit').attr('disabled', false);
                    }
                }
            });
            
        });
        function addDatatoModel() {
            if (!validateBooking()) {
                return false; // Prevent form submission if validation fails
            } else {
                var catId = $("#SelCat option:selected").val();
                if (catId == 1) {
                    $('#Category').val('DECOR');
                }
                if (catId == 2) {
                    $('#Category').val('STALL');
                }
                if (catId == 3) {
                    $('#Category').val('TRANS');
                }
                $('input[type=checkbox]').each(function () {


                    if (this.name == "CHK_ACTIVE") {
                        $('#isActive').val(this.checked);

                    }
                });

            }


        }

        
    </script>

