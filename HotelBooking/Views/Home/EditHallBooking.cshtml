@model HotelBooking.Model.Hall.HallBooking
@{
    ViewBag.Title = "Edit Hall Booking";
}

@{
    var jss = new System.Web.Script.Serialization.JavaScriptSerializer();
    var BFMItems = jss.Serialize(Model.HallBookingDetails);
    var themselected = false;
}

<link href="~/css/HallBooking.css" rel="stylesheet" />
<div class="row" id="EditBooking">
    <div class="col-sm-12">

        <div class="card widget-container" id="step1">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">


                <h3 style=" font-size: 20px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>
                <h3 style=" font-size: 16px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Step - 1 : Customer Details</h3>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Customer Name</label>
                        <input type="text" id="txtCustomerName" class="full-width" value="@Model.CustomerName" placeholder="Customer Name " maxlength="100" runat="server">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Customer Email</label>
                        <input type="text" id="txtCustomerEmail" class="full-width" value="@Model.CustomerEmail" placeholder="Customer Email" maxlength="150" runat="server">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Customer Phone</label>
                        <input type="text" id="txtCustomerPhone" class="full-width" value="@Model.CustomerPhone" placeholder="Customer Phone Number" maxlength="15" runat="server">
                    </div>
                    <div class="col-lg-6 col-md-6  col-sm-6 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Number of Person</label>
                        <input type="text" id="txtNPax" class="full-width" value="@Model.Number_Of_Person" placeholder="Number of Person" maxlength="15" runat="server">
                    </div>
                </div>




                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>

                    <input type="button" id="Step1Next" name="NEXT" class="prev action-button" value="Next" runat="server">
                </div>

            </form>
        </div>
        <div class="card widget-container" id="step2" style="display:none">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">


                <h3 style=" font-size: 20px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>
                <h3 style=" font-size: 16px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Step - 2 : Hall & Food</h3>


                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 p-0 pull-left">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pull-left">
                            <label for="edit-mail" class="form-required">Hall/Party on</label>
                            <input type="text" id="HallBookingDate" value="@Model.BookingDate" class="full-width allinputgo  ValidateInput" placeholder="Hall Booking Date" autocomplete="off">
                        </div>

                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Select a Hall</label>
                        <select name="SelHall" id="SelHall" class="full-width freetrial">
                            @if (ViewBag.PartyHall != null)
                            {
                                foreach (var item in ViewBag.PartyHall)
                                {
                                    if (item.Text != null)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">
                                            @item.Text.Trim()
                                        </option>

                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Select a Slot</label>
                        <select name="SelSlot" id="SelSlot" class="full-width freetrial">
                            @if (ViewBag.Slots != null)
                            {
                                foreach (var item in ViewBag.Slots)
                                {
                                    if (item.Text != null)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">
                                            @item.Text.Trim()
                                        </option>

                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 pull-left">
                        <label for="edit-mail" class="form-required">Select a Menu</label>
                        <select name="SelBM" id="SelBM" class="full-width freetrial">
                            @if (ViewBag.BuffetMenus != null)
                            {
                                foreach (var item in ViewBag.BuffetMenus)
                                {
                                    if (item.Text != null)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">
                                            @item.Text.Trim()
                                        </option>

                                    }
                                }
                            }
                        </select>
                    </div>



                </div>
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblAvailibility" style="display:none !important">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" class="clrwhit">Date</th>
                                    <th bgcolor="#003556" class="clrwhit">Customer Name</th>
                                    <th bgcolor="#003556" class="clrwhit">Slot </th>
                                    <th bgcolor="#003556" class="clrwhit">Status </th>

                                </tr>

                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                        <table class="table table-bordered" id="tblBFM" style="display:block !important">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" class="clrwhit">Item Selection</th>


                                </tr>

                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>





                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>
                    <input type="button" name="SUBMIT" id="btnStep2Prev" class="prev action-button " value="Previous" runat="server">
                    <input type="button" name="SUBMIT" id="btnStep2Next" class="prev action-button" value="Next" runat="server">
                </div>

            </form>
        </div>

        <div class="card widget-container" id="step3" style="display:none">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">

                <h3 style=" font-size: 20px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>
                <h3 style=" font-size: 16px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Step - 3 : Theme & Decoration</h3>

                <div class="row">

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblTheme">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" colspan="3" style="align-items: center" class="clrwhit">Select any one Theme</th>

                                </tr>

                            </thead>
                            <tbody>
                                @if (ViewBag.Decoration != null)
                                {
                                    foreach (var dcr in ViewBag.Decoration)
                                    {
                                        var txAmt = dcr.COST * dcr.Tax / 100;
                                        var totalCost = dcr.COST + dcr.TaxAmount;
                                        if (dcr.isSelected) { themselected = true; }
                                        var trselected = dcr.isSelected ? "Class=highlighted" : "";
                                        var trselectedVal = dcr.isSelected ? "YES" : "";
                                        <tr @trselected id="@dcr.ServiceId" Name="@dcr.Title" Cost="@dcr.COST" Tax="@dcr.Tax" TaxAmount="@txAmt" ThemeSelected=@trselectedVal onclick="SelectTheme(this);">

                                            <td>@dcr.Title</td>
                                            <td>@totalCost</td>
                                            <td style="align-items: center">
                                                @if (dcr.ContentType == "image/jpeg")
                                                {

                                                    String img6412 = Convert.ToBase64String(dcr.StreamData);
                                                    String img64Url12 = string.Format("data:image/jpeg;base64,{0}", img6412); //imagetype can be e.g. gif, jpeg, png etc.

                                                    <img style="width:50%;height:50%" src="@img64Url12" alt="">
                                                }
                                                else
                                                {
                                                    <video id="VideoPlayer" src='@Url.Action("DownloadVDOFile", "Home", new {HallServiceId = dcr.ServiceId})' controls="true"
                                                           width="400" height="350" loop="true" />
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    @if (themselected)
                                    {


                                        <td><input type="hidden" id="hdnSelectedTheme" value="YES" /></td>
                                    }
                                    else
                                    {
                                        <td><input type="hidden" id="hdnSelectedTheme" /></td>
                                    }



                                </tr>

                            </tfoot>
                        </table>

                    </div>

                </div>



                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>
                    <input type="button" name="SUBMIT" id="btnStep3Prev" class="prev action-button " value="Previous" runat="server">
                    <input type="button" name="SUBMIT" id="btnStep3Skip" class="prev action-button " onclick="SkipStep3();" value="Skip" runat="server">
                    <input type="button" name="SUBMIT" id="btnStep3Next" class="prev action-button" value="Next" runat="server">
                </div>

            </form>
        </div>
        <div class="card widget-container" id="step4" style="display:none">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">

                <h3 style=" font-size: 20px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>
                <h3 style=" font-size: 16px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Step - 4 : Stall Selection</h3>

                <div class="row">

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered spcl" id="tblStalls">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" style="align-items: center" class="clrwhit">Select Stalls</th>

                                </tr>

                            </thead>
                            <tbody>
                                @if (ViewBag.Stall != null)
                                {
                                    <tr>
                                        <td style="align-items:flex-start;width:20px !important">
                                            <div class="cont-main">

                                                @foreach (var dcr in ViewBag.Stall)
                                                {
                                                    var chkId = "myCheckbox-" + dcr.ServiceId;
                                                    String img6412 = Convert.ToBase64String(dcr.StreamData);
                                                    String img64Url12 = string.Format("data:image/jpeg;base64,{0}", img6412); //imagetype can be e.g. gif, jpeg, png etc.
                                                    var txAmt = dcr.COST * dcr.Tax / 100;
                                                    var totalCost = dcr.COST + dcr.TaxAmount;
                                                    <div class="cont-checkbox">
                                                        <input title="test" type="checkbox" id="@chkId" svcId="@dcr.ServiceId" Name="@dcr.Title" Cost="@dcr.COST" Tax="@dcr.Tax" TaxAmount="@txAmt" checked="@dcr.isSelected" />
                                                        <label for="@chkId">

                                                            <img src="@img64Url12" />
                                                            <span class="cover-checkbox">
                                                                <svg viewBox="0 0 12 10">
                                                                    <polyline points="1.5 6 4.5 9 10.5 1"></polyline>
                                                                </svg>
                                                            </span>
                                                            <div class="info">@dcr.Title</div>
                                                        </label>
                                                    </div>

                                                }
                                            </div>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                            <tfoot>

                            </tfoot>
                        </table>

                    </div>

                </div>



                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>
                    <input type="button" name="SUBMIT" id="btnStep4Prev" class="prev action-button " value="Previous" runat="server">
                    <input type="button" name="SUBMIT" id="btnStep4Skip" class="prev action-button " onclick="SkipStep4();" value="Skip" runat="server">
                    <input type="button" name="SUBMIT" id="btnStep4Next" class="prev action-button" value="Next" runat="server">
                </div>
            </form>
        </div>

        <div class="card widget-container" id="step5" style="display:none">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">

                <h3 style=" font-size: 20px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>
                <h3 style=" font-size: 16px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Step - 5: Transpotation(Vehicle)</h3>


                <div class="row">

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered spcl" id="tblVehicle">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" style="align-items: center" class="clrwhit">Select Vehicle</th>

                                </tr>

                            </thead>
                            <tbody>
                                @if (ViewBag.Trans != null)
                                {
                                    <tr>
                                        <td>
                                            <div class="cont-main">
                                                @foreach (var dcr in ViewBag.Trans)
                                                {
                                                    var chkId = "myCheckbox-" + dcr.ServiceId;
                                                    String img6412 = Convert.ToBase64String(dcr.StreamData);
                                                    String img64Url12 = string.Format("data:image/jpeg;base64,{0}", img6412); //imagetype can be e.g. gif, jpeg, png etc.
                                                    var txAmt = dcr.COST * dcr.Tax / 100;
                                                    var totalCost = dcr.COST + dcr.TaxAmount;


                                                    <div class="cont-checkbox">
                                                        <input title="test" type="checkbox" id="@chkId" svcId="@dcr.ServiceId" Name="@dcr.Title" Cost="@dcr.COST" Tax="@dcr.Tax" TaxAmount="@txAmt" checked="@dcr.isSelected" />
                                                        <label for="@chkId">

                                                            <img src="@img64Url12" />
                                                            <span class="cover-checkbox">
                                                                <svg viewBox="0 0 12 10">
                                                                    <polyline points="1.5 6 4.5 9 10.5 1"></polyline>
                                                                </svg>
                                                            </span>
                                                            <div class="info">@dcr.Title</div>
                                                        </label>
                                                    </div>


                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>

                    </div>

                </div>



                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>
                    <input type="button" name="btnStep5Prev" id="btnStep5Prev" class="prev action-button " value="Previous" runat="server">
                    <input type="button" name="SUBMIT" id="btnStep5Skip" class="prev action-button " onclick="SkipStep5();" value="Skip" runat="server">
                    <input type="button" name="btnStep5Next" id="btnStep5Next" class="prev action-button" value="Next" runat="server">
                </div>

            </form>
        </div>

        <div class="card widget-container" id="step6" style="display:none">
            <form id="msform" runat="server" action="javascript:void(0)" method="get" style=" margin:0px auto;">
                <h3 style=" font-size: 20px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Party Hall  Reservation</h3>
                <h3 style=" font-size: 16px; font-weight: 600; color: #003556; text-align: left; padding: 15px 0px 0px 15px;">Step - 6 : Cost and Payments</h3>

                <div class="row">

                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12 table-responsive weblogtbl">
                        <table class="table table-bordered" id="tblCosting">
                            <thead>
                                <tr>
                                    <th bgcolor="#003556" class="clrwhit">#</th>
                                    <th bgcolor="#003556" class="clrwhit">Description</th>
                                    <th bgcolor="#003556" class="clrwhit">Amount </th>

                                </tr>

                            </thead>
                            <tbody>

                                <tr>
                                    <td bgcolor="#003556" style="color:#FFFFFF" align="center" colspan="3">Costing</td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Hall Rent</td>
                                    <td align="right"><span id="hRentCostId"></span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Food Costing</td>
                                    <td align="right"><span id="fdCostingId">0.00</span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Theme & Decoration</td>
                                    <td align="right"><span id="themeCostingId">0.00</span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Additional Stalls</td>
                                    <td align="right"><span id="stallCostingId">0.00</span></td>
                                </tr>
                                <tr>
                                    <td>#</td>
                                    <td align="left">Transport &; Vehicle</td>
                                    <td align="right"><span id="vehicleCostingId">0.00</span></td>
                                </tr>
                                <tr>

                                    <td align="right" colspan="2">Total Cost</td>
                                    <td align="right"><span id="totalCostId"></span></td>
                                </tr>
                                <tr>
                                    <td bgcolor="#003556" align="center" style="color:#FFFFFF" colspan="3">Payment</td>
                                </tr>
                                @foreach (var pmt in Model.HallBookingPayment)
                                {
                                    <tr id="@pmt.HallBookingPaymentId">
                                        <td>#</td>
                                        <td align="left">@pmt.paymentDate</td>
                                        <td align="left"><input type="text" id="txtPmtDesc" class="full-width" placeholder="Description" maxlength="15" readonly="readonly" value="@pmt.Description" runat="server"></td>
                                        <td align="right"><input type="text" id="txtPmtAmt" class="full-width" style="text-align:right !important" readonly="readonly" placeholder="Amount" maxlength="15" value="@pmt.Amount" runat="server"></td>


                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </div>
                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12 pull-right form-group">
                    <label for="edit-mail" class="form-required">&nbsp;</label>
                    <input type="button" name="btnStep6Prev" id="btnStep6Prev" class="prev action-button " value="Previous" runat="server">
                    <input type="button" name="SUBMIT" class="prev action-button " onclick="SaveHallBooking(this);" value="Modify" runat="server">
                </div>


            </form>
        </div>

        
    </div>
</div>

<div class="modal fade" id="reason_for_modal">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="width:180% !important">
            <!-- Modal Header -->
            <div class="modal-header">
                <center> Skip Confirmation </center>
            </div>
            <!-- Modal body -->
            <div class="modal-body panel-body">
                <center>
                    <br><br>
                    <p> <strong> You are skiping the Theme and Decoraton selection </strong> </p>

                </center>
            </div>
            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="col-sm-15">
                    <div class="form-group">
                        <button type="button" id="btnCencelSkip" class="btn btn-success pull-right" data-dismiss="modal"> Cancel</button>
                        <button type="button" id="btnSkip3" onclick="SkipStep3()" class="btn btn-danger pull-right" data-dismiss="modal">
                            <span class="fa fa-check"></span>
                            Skip
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    let HallBookingDetails= '' || [];
    $(document).ready(function () {
       $("#Step1Next").on("click", function () {
            $("#step1").css('display', 'none');
            $("#step2").css('display', 'block');
        });
        $("#btnStep2Prev").on("click", function () {
            $("#step1").css('display', 'block');
            $("#step2").css('display', 'none');
        });
        $("#btnStep2Next").on("click", function () {
            $("#step3").css('display', 'block');
            $("#step2").css('display', 'none');
        });

        $("#btnStep3Prev").on("click", function () {
            $("#step2").css('display', 'block');
            $("#step3").css('display', 'none');
        });
        $("#btnStep3Next").on("click", function () {

            var thSel = $("#hdnSelectedTheme").val();
            if (thSel == '') {
                $(document.body).append($("#reason_for_modal").clone());
                $("#reason_for_modal").remove();
                $("#reason_for_modal").modal('show');
            } else {
                $("#step4").css('display', 'block');
                $("#step3").css('display', 'none');
                AddPStoCosting();
            }
        });

        $("#btnStep4Prev").on("click", function () {
            $("#step3").css('display', 'block');
            $("#step4").css('display', 'none');
        });
        $("#btnStep4Next").on("click", function () {
            $("#step5").css('display', 'block');
            $("#step4").css('display', 'none');
            AddStalltoCosting();
        });
        $("#btnStep5Prev").on("click", function () {
            $("#step4").css('display', 'block');
            $("#step5").css('display', 'none');
        });
        $("#btnStep5Next").on("click", function () {
            $("#step6").css('display', 'block');
            $("#step5").css('display', 'none');
            AddVehicletoCosting();
        });

        $("#btnStep6Prev").on("click", function () {
            $("#step5").css('display', 'block');
            $("#step6").css('display', 'none');
        });

        $("#hRentCostId").change(function () {
            CalCulateTotal();
        });
        $("#fsvsostingId").change(function () {
            CalCulateTotal();
        });
        $("#fdCostingId").change(function () {
            //console.log("Change Event fired");
            CalCulateTotal();
        });
        var ArrMId = $("#SelBM option:selected").val().split("-");
        //$("#SelBM").val(Number(ArrMId[0]));

        var nPax = @Model.Number_Of_Person;
        mCost = Number(ArrMId[1]);
        var totalFoodCost = Number(mCost) * Number(nPax);
        $("#fdCostingId").text(Number(totalFoodCost).toFixed(2));
        $("#fdCostingId").trigger("change");
        //AddPStoCosting();



        $("#SelSlot").val('@Model.SlotId');

        var ArrhId = $("#SelHall option:selected").val().split("-");


        $("#hRentCostId").text(Number(ArrhId[1]).toFixed(2));
        $("#hRentCostId").trigger("change");




        getBuffetMenuDetails(ArrMId[0]);


        $("#HallBookingDate").datepicker({
            dateFormat: "mm-dd-yy",
            duration: "fast",
            minDate: 0,
            disabledDates: [new Date()],

        });


    });
    function getBuffetMenuDetails(menuId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("getBuffetMenu", "Home")',

            data: { buffetMenuId: menuId },

            success: function (GLBuffetMenuDetails) {
                var trItems = "";
                //console.log("test"+GLBuffetMenuDetails);
                GLBuffetMenuDetails.forEach((itm, itmIndex) => {

                    trItems += ' <tr>    ';
                    trItems += '<td style="padding:10px 15px !important"><ul class="menulist"> <h3>' + itm.BuffetMenuCategory + ' </h3>';
                    var itemIds = "'";
                    var headingIds;
                    itm.ItemDetails.forEach((itm1, itmIndex) => {
                        itemIds = itemIds + itm1.ItemId + "-";
                        headingIds = itm1.HeadingId;
                        var chkid = 'CHK_' + itm1.ItemId;
                        var isSelected = '';
